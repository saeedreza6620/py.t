const FORM = t => { const out = []; const re = /_\(([^)]*)\)|_([A-Za-z0-9]+)|\^\(([^)]*)\)/g; let k = 0, m;
  const run = (x, o = {}) => new TextRun({ text: x, font: 'Cambria Math', size: 24, ...o });
  while ((m = re.exec(t)) !== null) { if (m.index > k) out.push(run(t.slice(k, m.index)));
    if (m[3] !== undefined) out.push(run(m[3], { superScript: true })); else out.push(run(m[1] ?? m[2], { subScript: true })); k = m.index + m[0].length; }
  if (k < t.length) out.push(run(t.slice(k)));
  return new Paragraph({ alignment: AlignmentType.CENTER, bidirectional: false, spacing: { before: 60, after: 120 }, children: out }); };

let eqn = 0;
