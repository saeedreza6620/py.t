# ===== صنعت‌هاب — متغیرهای محیطی (فقط نام‌ها؛ مقدارها را در پنل لیارا بگذارید) =====

# امنیت نشست — یک رشته تصادفی بلند (حداقل ۳۲ کاراکتر)
SESSION_SECRET=

# شماره‌های مدیر (با کاما جدا). اولین ورود با این شماره‌ها نقش «مدیر» می‌گیرد.
ADMIN_PHONES=09120000000

# پیامک کد ورود (کاوه‌نگار، سرویس Verify Lookup)
KAVENEGAR_API_KEY=
KAVENEGAR_TEMPLATE=
# تا وقتی پیامک تنظیم نشده، در پایلوت کد روی صفحه نمایش داده شود (بعداً حذف کنید)
OTP_DEV_SHOW=1

# ---- قیمت زنده دلار ----
# گزینه ۱: نوسان (api.navasan.tech)
NAVASAN_API_KEY=
NAVASAN_ITEM=usd_sell
# گزینه ۲: هر API دیگری که JSON برمی‌گرداند
USD_URL=
USD_JSON_PATH=
USD_UNIT=toman
USD_SOURCE_NAME=

# ---- قیمت جهانی مس (اختیاری؛ وگرنه از پنل مدیر) ----
COPPER_URL=
COPPER_JSON_PATH=
COPPER_UNIT=ton
COPPER_SOURCE_NAME=

# دیتابیس: پیش‌فرض فایل SQLite در DATA_DIR. برای لیارا یک دیسک بسازید و اینجا مسیرش را بدهید.
DATA_DIR=/usr/src/app/data
# یا libSQL/Turso:
DATABASE_URL=
DATABASE_AUTH_TOKEN=
